{erl_opts, [debug_info]}.

{deps, [
    {elmdb, {git, "https://github.com/permaweb/elmdb-rs.git",
        {ref, "faa762323be6bad2db26abfa1d4243863a877f0f"}}},
    {hb, {git, "https://github.com/permaweb/HyperBEAM.git",
        {ref, "10c0b765cc235d52086a6bd30d2cd9d698d9deca"}}}
]}.

{overrides, [
    {override, cowboy, [{deps, [cowlib, ranch]}]},
    {override, gun, [{deps, [cowlib]}]}
]}.

{plugins, [
    {plugin,
        {git_subdir, "https://github.com/permaweb/HyperBEAM.git",
            {ref, "10c0b765cc235d52086a6bd30d2cd9d698d9deca"},
            "src/forge"}},
    {rebar3_eunit_start,
        {git, "https://github.com/permaweb/rebar3_eunit_start.git",
            {ref, "04ec53fea187039770db0d4459b7aeb01a9021af"}}}
]}.

{eunit_opts, [verbose, {start_applications, [prometheus, hb]}]}.

{shell, [
    {apps, [hb]}
]}.

{alias, [
    {'eunit-all',
        [
            {device, "test --with-core"}
        ]
    },
    {'mint-authority-test',
        [
            {device, "test --device-src=src,_build/default/lib/hb/src/preloaded/token,../mint-authority/src,../outbox-1.0/src,../security/src --timeout 120"}
        ]
    }
]}.

{provider_hooks, [
    {pre, [
        {eunit, {default, rebar3_eunit_start}}
    ]}
]}.
